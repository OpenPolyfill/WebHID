{
  "name": "FF-WebHID",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/FF-WebHID,type=bind",
  "workspaceFolder": "/workspaces/FF-WebHID",
  "remoteUser": "node",
  "runArgs": ["--userns=keep-id"],
  "containerEnv": {
    "CARGO_HOME": "/home/node/.cargo",
    "OPENPOLYFILL_BROWSERS_PATH": "/home/node/.cache/openpolyfill",
    "npm_config_cache": "/home/node/.npm"
  },
  "postCreateCommand": "npm ci --ignore-scripts && npm rebuild @openpolyfill/firefox-addon-playwright-harness"
}
